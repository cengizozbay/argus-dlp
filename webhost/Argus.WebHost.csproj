<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe = pencere/konsol AÇMAZ (tarayıcı köprüyü başlatınca hiçbir flash olmaz). stdin/stdout yine çalışır. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Argus.WebHost</AssemblyName>
    <RootNamespace>Argus.WebHost</RootNamespace>
  </PropertyGroup>

</Project>
